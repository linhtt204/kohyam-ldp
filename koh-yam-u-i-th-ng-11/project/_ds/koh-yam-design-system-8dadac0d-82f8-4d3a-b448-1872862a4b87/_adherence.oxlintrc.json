{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/social/**",
              "ui_kits/social-posts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat Alternates|Allison|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Montserrat Alternates, Allison, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|small|href|children|onClick|key|ref|className|style|children)$/]",
        "message": "<CTAButton> doesn't accept that prop. Declared props: variant, size, label, small, href, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|stack)$/]",
        "message": "<CTAButton> variant must be one of 'primary' | 'outline' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTAButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<CTAButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Island'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|name|addr|tone|status|key|ref|className|style|children)$/]",
        "message": "<Island> doesn't accept that prop. Declared props: slug, name, addr, tone, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='IslandStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:island|kicker|name|sub|date|tilt|key|ref|className|style|children)$/]",
        "message": "<IslandStamp> doesn't accept that prop. Declared props: island, kicker, name, sub, date, tilt."
      },
      {
        "selector": "JSXOpeningElement[name.name='IslandStamp'] > JSXAttribute[name.name='island'] > Literal[value!=/^(?:giang-vo|quang-trung-34a|quang-trung-2d|ba-trieu|ho-tung-mau|ba-huyen-thanh-quan)$/]",
        "message": "<IslandStamp> island must be one of 'giang-vo' | 'quang-trung-34a' | 'quang-trung-2d' | 'ba-trieu' | 'ho-tung-mau' | 'ba-huyen-thanh-quan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LandmarkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:landmark|kicker|name|dish|quote|rows|key|ref|className|style|children)$/]",
        "message": "<LandmarkCard> doesn't accept that prop. Declared props: landmark, kicker, name, dish, quote, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='LandmarkCard'] > JSXAttribute[name.name='landmark'] > Literal[value!=/^(?:suoi-thao-moc|bien-do|nui-lua|song-bang|rung-gion)$/]",
        "message": "<LandmarkCard> landmark must be one of 'suoi-thao-moc' | 'bien-do' | 'nui-lua' | 'song-bang' | 'rung-gion'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:island|children|key|ref|className|style|children)$/]",
        "message": "<LocationTag> doesn't accept that prop. Declared props: island, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|tagline|ink|height|tab|tabBg|assetBase|src|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: layout, tagline, ink, height, tab, tabBg, assetBase, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|horizontal)$/]",
        "message": "<Logo> layout must be one of 'stacked' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='ink'] > Literal[value!=/^(?:brown|gold|cream)$/]",
        "message": "<Logo> ink must be one of 'brown' | 'gold' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PatternBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|height|opacity|background|position|assetBase|key|ref|className|style|children)$/]",
        "message": "<PatternBand> doesn't accept that prop. Declared props: pattern, height, opacity, background, position, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Postmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:top|bottom|center|color|size|key|ref|className|style|children)$/]",
        "message": "<Postmark> doesn't accept that prop. Declared props: top, bottom, center, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|children|key|ref|className|style|children)$/]",
        "message": "<PromoTag> doesn't accept that prop. Declared props: size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<PromoTag> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialPost'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|photo|title|caption|cta|ctaSmall|island|address|size|assetBase|children|key|ref|className|style|children)$/]",
        "message": "<SocialPost> doesn't accept that prop. Declared props: layout, photo, title, caption, cta, ctaSmall, island, address, size, assetBase, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialPost'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:xanh|kem)$/]",
        "message": "<SocialPost> layout must be one of 'xanh' | 'kem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SoSanhPhuongAn'] > JSXAttribute > JSXIdentifier[name!=/^(?:pick|key|ref|className|style|children)$/]",
        "message": "<SoSanhPhuongAn> doesn't accept that prop. Declared props: pick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SoSanhPhuongAn'] > JSXAttribute[name.name='pick'] > Literal[value!=/^(?:A|B)$/]",
        "message": "<SoSanhPhuongAn> pick must be one of 'A' | 'B'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|island|tilt|logoHeight|tagline|assetBase|children|key|ref|className|style|children)$/]",
        "message": "<StampLogo> doesn't accept that prop. Declared props: variant, island, tilt, logoHeight, tagline, assetBase, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|cream|green|island)$/]",
        "message": "<StampLogo> variant must be one of 'gold' | 'cream' | 'green' | 'island'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StampLogo'] > JSXAttribute[name.name='island'] > Literal[value!=/^(?:giang-vo|quang-trung-34a|quang-trung-2d|ba-trieu|ho-tung-mau|ba-huyen-thanh-quan)$/]",
        "message": "<StampLogo> island must be one of 'giang-vo' | 'quang-trung-34a' | 'quang-trung-2d' | 'ba-trieu' | 'ho-tung-mau' | 'ba-huyen-thanh-quan'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
